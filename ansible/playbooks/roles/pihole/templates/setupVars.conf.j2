# {{ ansible_managed }}
PIHOLE_INTERFACE={{ pihole_interface }}
IPV4_ADDRESS={{ pihole_ipv4_address }}
IPV6_ADDRESS={{ pihole_ipv6_address }}
QUERY_LOGGING={{ pihole_query_logging | bool | lower }}
INSTALL_WEB_SERVER=true
INSTALL_WEB_INTERFACE=true
LIGHTTPD_ENABLED=false
CACHE_SIZE=10000
DNS_FQDN_REQUIRED=true
DNS_BOGUS_PRIV=true
DNSMASQ_LISTENING={{ pihole_listening_mode }}
WEBPASSWORD=
BLOCKING_ENABLED={{ pihole_blocking_enabled | bool | lower }}
DNSSEC={{ pihole_dnssec | bool | lower }}
REV_SERVER={{ pihole_rev_server | bool | lower }}
PIHOLE_DNS_1={{ pihole_upstream_dns_1 }}
PIHOLE_DNS_2={{ pihole_upstream_dns_2 }}
